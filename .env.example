# Filled in automatically by `npm run get-token`, or set manually:
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: lock CORS down to your artifact's origin once you know it. Defaults to * (open).
ALLOWED_ORIGIN=*

# Only needed once, for the get-token.js helper:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
